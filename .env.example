# SenseVoice ASR（可选；两个变量都配置后 ASR 走真实 API，否则使用确定性 Mock）
# 运行时只读取 os.environ，请通过环境变量注入，不要把真实密钥提交到仓库。
SENSEVOICE_API_URL=
SENSEVOICE_API_KEY=

# DeepSeek AI 援助（可选；未配置 DEEPSEEK_API_KEY 时页面显示中性未开通提示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_WEB_SEARCH_ENABLED=1
DEEPSEEK_TIMEOUT_SEC=60
DEEPSEEK_MAX_TOKENS=800
