# 复制为 .env.local 后按需修改；token 走环境注入。
# 1 = 使用 web/src/mock/ 下的本地假数据；0 = 走 Vite 代理访问 http://127.0.0.1:8000
VITE_USE_MOCK=1
VITE_API_BASE_URL=
VITE_USER_TOKEN=user_demo
VITE_ADMIN_TOKEN=admin_demo
# 登录后使用的演示对象；默认对应 seed_demo 的 S001（需先执行 python scripts/seed_demo.py）
VITE_SUBJECT_ID=d0676c19-7042-5d41-ba03-3c855a301acd
# 管理端路由守卫使用；原型默认 staff
VITE_ROLE=staff
# 用户端开发测试账号（仅用于本地联调，生产环境需替换为真实认证）
VITE_DEMO_USERNAME=张三
VITE_DEMO_PASSWORD=123456
